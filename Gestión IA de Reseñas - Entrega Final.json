    {
      "parameters": {
        "jsCode": "\nconst kb = $input.all();\nlet ctx = '';\nfor (const row of kb) {\n  const j = row.json || {};\n  const titulo = j['property_titulo'] || j['Titulo'] || j['Título'];\n  const categoria = j['property_categoria'] || j['Categoria'] || j['Categoría'];\n  const contenido = j['property_contenido'] || j['Contenido'];\n  if (!titulo && !contenido) continue;\n  ctx += '### ' + (titulo || 'Sin título') + ' (Categoría: ' + (categoria || 'N/D') + ')\\n';\n  ctx += (contenido || '') + '\\n\\n';\n}\nif (!ctx.trim()) {\n  ctx = 'No hay información disponible en la Base de Conocimiento.';\n}\n\nconst norm = $('2. Validar y Normalizar').first().json;\nconst review = $('7. Crear Reseña').first().json;\n\nreturn [{\n  json: {\n    nombre: norm.nombre,\n    email: norm.email,\n    calificacion: norm.calificacion,\n    resena_original: norm.resena_original,\n    idea_semilla: norm.idea_semilla,\n    contexto_rag: ctx.trim(),\n    resena_page_id: review.id,\n  },\n}];\n"
      },
