    {
      "parameters": {
        "jsCode": "\n// --- Extraer payload de Tally (soporta formato Tally y formato plano) ---\nconst item = $input.first().json || {};\nconst body = item.body || item;\n\nfunction norm(s) { return (s === undefined || s === null) ? '' : String(s).trim(); }\n\nlet nombre = '', email = '', fecha_estadia = '', calificacion = '', positivos = '', mejorar = '';\n\nif (body.data && Array.isArray(body.data.fields)) {\n  // Formato oficial Tally: body.data.fields[]\n  for (const f of body.data.fields) {\n    const label = (f.label || '').toLowerCase();\n    const type = (f.type || '').toUpperCase();\n    let value = f.value;\n    // Multiple choice / dropdown con options -> resolver texto\n    if (Array.isArray(value) && Array.isArray(f.options)) {\n      const map = {};\n      for (const o of f.options) { map[o.id] = o.text; }\n      value = value.map(v => map[v] || v).join(', ');\n    } else if (Array.isArray(value)) {\n      value = value.join(', ');\n    }\n    if (label.includes('nombre')) nombre = norm(value);\n    else if (type === 'INPUT_EMAIL' || label.includes('email') || label.includes('correo')) email = norm(value);\n    else if (type === 'INPUT_DATE' || label.includes('fecha')) fecha_estadia = norm(value);\n    else if (type === 'RATING' || label.includes('calific')) calificacion = norm(value);\n    else if (label.includes('disfrut') || label.includes('más') || label.includes('mas')) positivos = norm(value);\n    else if (label.includes('mejorar') || label.includes('mejora')) mejorar = norm(value);\n  }\n} else {\n  // Formato plano (pruebas / integraciones simples)\n  nombre = norm(body.nombre || body.name);\n  email = norm(body.email);\n  fecha_estadia = norm(body.fecha_estadia || body.fecha || body.stayDate);\n  calificacion = norm(body.calificacion || body.rating);\n  positivos = norm(body.aspectos_positivos || body.positivos);\n  mejorar = norm(body.aspectos_mejorar || body.mejorar);\n}\n\n// --- Validación de obligatorios ---\nconst faltantes = [];\nif (!nombre) faltantes.push('nombre del huésped');\nif (!email) faltantes.push('email');\nif (!fecha_estadia) faltantes.push('fecha de estadía');\nif (!calificacion) faltantes.push('calificación');\nif (!positivos) faltantes.push('aspectos positivos');\n\nconst valido = faltantes.length === 0;\nconst error_mensaje = valido ? '' : ('Faltan datos obligatorios: ' + faltantes.join(', ') + '.');\n\n// --- Normalización ---\nconst calif_num = Number(String(calificacion).replace(/[^0-9.]/g, '')) || 0;\nconst mejorar_final = mejorar || 'No se indicaron aspectos a mejorar.';\nconst resena_original =\n  'Aspectos positivos: ' + (positivos || '') + '\\n' +\n  'Aspectos a mejorar: ' + mejorar_final;\n\nconst idea_semilla = 'Redactar una respuesta breve, cercana y profesional para la reseña del huésped, adaptando el tono y el contenido según la calificación recibida y la experiencia expresada. Utiliza exclusivamente la información contenida en la reseña del huésped y en la Base de Conocimiento del hotel. No inventes información ni respondas preguntas que no puedan justificarse con dichas fuentes.';\n\nconst stamp = Date.now();\nconst id_resena = 'RES-' + stamp + '-' + Math.floor(Math.random() * 10000);\n\nreturn [{\n  json: {\n    valido,\n    error_mensaje,\n    nombre,\n    email,\n    fecha_estadia,\n    calificacion: calif_num,\n    aspectos_positivos: positivos,\n    aspectos_mejorar: mejorar_final,\n    id_resena,\n    resena_original,\n    idea_semilla,\n  },\n}];\n"
      },
